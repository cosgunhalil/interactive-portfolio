-- Touch HUD: a virtual joystick on the lower left and one action button on the lower right.
-- The joystick posts a direction to the player; the button posts "interact". The button is
-- hidden until the interaction system sends show_prompt, so it doubles as the prompt.

local PLAYER = "/player#script"

local TOUCH = hash("touch")
local TOUCH_MULTI = hash("touch_multi")
local SHOW_PROMPT = hash("show_prompt")
local HIDE_PROMPT = hash("hide_prompt")
local PLAYER_MOVED = hash("player_moved")
local WINDOW_RESIZED = hash("window_resized")
local ROOM_CHANGED = hash("room_changed")
local TITLE_HOLD = 2.0 -- seconds the room title stays fully visible before fading

local MOUSE_ID = "mouse"
local KNOB_TRAVEL = 60 -- max knob offset from the base centre, at ui scale 1
local DESIGN_HEIGHT = 640 -- ui scale 1 corresponds to a 640 px short side
local DEAD_ZONE = 0.15 -- fraction of KNOB_TRAVEL below which no movement is sent
local HINT_DELAY = 3 -- seconds without movement before the idle hint appears

-- Positions and sizes are computed from the real window size (the HTML5 canvas follows the
-- browser window, so portrait phones have a tall, narrow window at device pixel ratio).
local function layout(self)
	local w, h = window.get_size()
	local s = math.max(1, math.min(w, h) / DESIGN_HEIGHT)
	self.ui_scale = s
	self.knob_travel = KNOB_TRAVEL * s
	local margin = 130 * s
	self.base_pos = vmath.vector3(margin, margin, 0)
	gui.set_position(self.base, self.base_pos)
	gui.set_position(self.knob, self.base_pos)
	gui.set_position(self.button, vmath.vector3(w - 120 * s, margin, 0))
	gui.set_position(self.hint, vmath.vector3(w / 2, h - 70 * s, 0))
	gui.set_size(self.hint, vmath.vector3(w / s - 40, 60, 0))
	gui.set_position(self.title, vmath.vector3(w / 2, h - 140 * s, 0))
	for _, node in ipairs({ self.base, self.knob, self.button, self.hint, self.title }) do
		gui.set_scale(node, vmath.vector3(s, s, 1))
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.base = gui.get_node("joystick_base")
	self.knob = gui.get_node("joystick_knob")
	self.button = gui.get_node("action_button")
	self.label = gui.get_node("action_label")
	self.hint = gui.get_node("hint")
	self.title = gui.get_node("room_title")
	gui.set_alpha(self.title, 0)
	layout(self)
	self.joy_id = nil -- id of the pointer currently driving the joystick
	self.dir = vmath.vector3()
	self.multitouch = false -- set once a TOUCH_MULTI action is seen; then plain "touch" is ignored
	gui.set_enabled(self.button, false)
	self.idle = 0
	self.moved = false
	gui.set_enabled(self.hint, false)
end

function update(self, dt)
	if not self.moved then
		self.idle = self.idle + dt
		if self.idle >= HINT_DELAY then
			gui.set_enabled(self.hint, true)
		end
	end
end

local function send_dir(self, dir)
	if dir.x ~= self.dir.x or dir.y ~= self.dir.y then
		self.dir = dir
		msg.post(PLAYER, "joystick", { x = dir.x, y = dir.y })
	end
end

local function joystick_update(self, x, y)
	local offset = vmath.vector3(x, y, 0) - self.base_pos
	local len = vmath.length(offset)
	if len > self.knob_travel then
		offset = offset * (self.knob_travel / len)
		len = self.knob_travel
	end
	gui.set_position(self.knob, self.base_pos + offset)
	if len / self.knob_travel < DEAD_ZONE then
		send_dir(self, vmath.vector3())
	else
		send_dir(self, vmath.normalize(offset))
	end
end

local function joystick_release(self)
	self.joy_id = nil
	gui.set_position(self.knob, self.base_pos)
	send_dir(self, vmath.vector3())
end

-- Any press on the lower-left part of the screen grabs the joystick, not just the base itself.
-- NOTE: action.x/y are scaled to the game.project display size; screen_x/screen_y are real
-- window pixels, which is what the layout uses.
local function in_joystick_zone(x, y)
	local w, h = window.get_size()
	return x < w * 0.45 and y < h * 0.75
end

-- Window-pixel hit test. gui.pick_node is not used because the layout is done in window
-- pixels with GUI adjust disabled.
local function hit(node, x, y)
	local p = gui.get_position(node)
	local half = gui.get_size(node) * 0.5
	local sc = gui.get_scale(node)
	return math.abs(x - p.x) <= half.x * sc.x and math.abs(y - p.y) <= half.y * sc.y
end

-- Handles one pointer (a finger or the mouse), in window pixels. Returns true if consumed.
local function handle_pointer(self, id, x, y, pressed, released)
	if self.joy_id == id then
		if released then
			joystick_release(self)
		else
			joystick_update(self, x, y)
		end
		return true
	end
	if pressed then
		if gui.is_enabled(self.button) and hit(self.button, x, y) then
			msg.post(PLAYER, "interact")
			return true
		end
		if self.joy_id == nil and in_joystick_zone(x, y) then
			self.joy_id = id
			joystick_update(self, x, y)
			return true
		end
	end
	return false
end

function on_input(self, action_id, action)
	if action_id == TOUCH_MULTI then
		if not self.multitouch then
			self.multitouch = true
			if self.joy_id == MOUSE_ID then
				joystick_release(self)
			end
		end
		local consumed = false
		for _, t in ipairs(action.touch) do
			if handle_pointer(self, t.id, t.screen_x, t.screen_y, t.pressed, t.released) then
				consumed = true
			end
		end
		return consumed
	elseif action_id == TOUCH and not self.multitouch then
		return handle_pointer(self, MOUSE_ID, action.screen_x, action.screen_y, action.pressed, action.released)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == SHOW_PROMPT then
		gui.set_text(self.label, message.text or "Interact")
		gui.set_enabled(self.button, true)
	elseif message_id == HIDE_PROMPT then
		gui.set_enabled(self.button, false)
	elseif message_id == PLAYER_MOVED then
		self.moved = true
		gui.set_enabled(self.hint, false)
	elseif message_id == WINDOW_RESIZED then
		layout(self)
	elseif message_id == ROOM_CHANGED then
		gui.set_text(self.title, message.title)
		gui.cancel_animation(self.title, "color.w")
		gui.set_alpha(self.title, 1)
		gui.animate(self.title, "color.w", 0, gui.EASING_INQUAD, 0.6, TITLE_HOLD)
	end
end
