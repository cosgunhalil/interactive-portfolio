local movement = require("main.movement")
local overlay = require("main.overlay")

local HUD = "/hud#gui"
local CAMERA = "#camera"
local VIEW_SHORT_SIDE = 176 -- world px (11 tiles) to fit along the window's shorter side

local ACTION_UP = hash("up")
local ACTION_DOWN = hash("down")
local ACTION_LEFT = hash("left")
local ACTION_RIGHT = hash("right")
local ACTION_INTERACT = hash("interact")
local ACTION_CLOSE = hash("close")
local MSG_JOYSTICK = hash("joystick")
local MSG_INTERACT = hash("interact")
local MSG_INTERACT_ENTER = hash("interact_enter")
local MSG_INTERACT_EXIT = hash("interact_exit")
local CONTACT_POINT_RESPONSE = hash("contact_point_response")

local function reset_input(self)
	self.keys.up, self.keys.down, self.keys.left, self.keys.right = false, false, false, false
	self.joy = vmath.vector3()
end

-- Integer zoom keeps pixel art crisp; the shorter window side always shows about 11 tiles,
-- whatever the device pixel ratio or orientation.
local function fit_camera(width, height)
	local zoom = math.max(1, math.floor(math.min(width, height) / VIEW_SHORT_SIDE))
	go.set(CAMERA, "orthographic_zoom", zoom)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	fit_camera(window.get_size())
	window.set_listener(function(_, event, data)
		if event == window.WINDOW_EVENT_RESIZED then
			fit_camera(data.width, data.height)
			msg.post(HUD, "window_resized")
		end
	end)
	self.keys = {}
	reset_input(self)
	self.dir = vmath.vector3()
	self.target = nil -- url of the interactable currently in range
	self.moved = false -- becomes true on first movement; tells the HUD to drop the idle hint
	-- Accumulated collision correction for this frame. Kinematic bodies are not
	-- resolved by the engine, so the script pushes itself out of walls.
	self.correction = vmath.vector3()
end

function update(self, dt)
	self.correction = vmath.vector3()
	overlay.update()
	if overlay.is_open() then
		-- Nothing moves while the visitor is reading or watching.
		reset_input(self)
		return
	end
	self.dir = movement.direction(self.keys.up, self.keys.down, self.keys.left, self.keys.right)
	if vmath.length_sqr(self.dir) == 0 then
		self.dir = self.joy
	end
	if vmath.length_sqr(self.dir) > 0 then
		go.set_position(movement.step(go.get_position(), self.dir, dt))
		if not self.moved then
			self.moved = true
			msg.post(HUD, "player_moved")
		end
	end
end

local function handle_contact(self, message)
	if message.distance > 0 then
		local proj = vmath.project(self.correction, message.normal * message.distance)
		if proj < 1 then
			local comp = (message.distance - message.distance * proj) * message.normal
			go.set_position(go.get_position() + comp)
			self.correction = self.correction + comp
		end
	end
end

local function interact(self)
	if overlay.is_open() or not self.target then
		return
	end
	reset_input(self)
	msg.post(self.target, "activate")
end

function on_message(self, message_id, message, sender)
	if message_id == CONTACT_POINT_RESPONSE then
		handle_contact(self, message)
	elseif message_id == MSG_JOYSTICK then
		self.joy = vmath.vector3(message.x, message.y, 0)
	elseif message_id == MSG_INTERACT then
		interact(self)
	elseif message_id == MSG_INTERACT_ENTER then
		self.target = sender
		msg.post(HUD, "show_prompt", { text = message.prompt })
	elseif message_id == MSG_INTERACT_EXIT then
		if self.target == sender then
			self.target = nil
			msg.post(HUD, "hide_prompt")
		end
	end
end

local function set_key(self, name, action)
	-- released is checked first so a press and release in the same frame ends as "not held"
	if action.released then
		self.keys[name] = false
	elseif action.pressed then
		self.keys[name] = true
	end
end

function on_input(self, action_id, action)
	if action_id == ACTION_CLOSE then
		if action.pressed then
			overlay.close()
		end
		return true
	end
	if overlay.is_open() then
		return true
	end
	if action_id == ACTION_UP then
		set_key(self, "up", action)
	elseif action_id == ACTION_DOWN then
		set_key(self, "down", action)
	elseif action_id == ACTION_LEFT then
		set_key(self, "left", action)
	elseif action_id == ACTION_RIGHT then
		set_key(self, "right", action)
	elseif action_id == ACTION_INTERACT and action.pressed then
		interact(self)
	end
end
